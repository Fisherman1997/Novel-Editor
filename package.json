{
  "name": "novel-editor",
  "version": "2.0.1",
  "description": "小说编辑器 - 功能完善的桌面写作工具",
  "main": "./out/main/index.js",
  "author": "Fisherman1997",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config",
    "builder:win": "electron-builder --win --config",
    "builder:mac": "electron-builder --mac --config",
    "builder:linux": "electron-builder --linux --config",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^2.0.0",
    "@electron-toolkit/utils": "^2.0.0",
    "@tiptap/extension-highlight": "^2.1.0",
    "@tiptap/extension-link": "^2.1.0",
    "@tiptap/extension-placeholder": "^2.1.0",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.1.0",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.1.0",
    "@tiptap/starter-kit": "^2.1.0",
    "@tiptap/vue-3": "^2.1.0",
    "@vueuse/core": "^10.0.0",
    "electron-updater": "^6.1.0",
    "element-plus": "^2.4.3",
    "markdown-it": "^15.0.2",
    "pinia": "^2.1.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^1.0.1",
    "@electron-toolkit/eslint-config-ts": "^1.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@rushstack/eslint-patch": "^1.3.3",
    "@types/node": "^18.17.5",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-vue": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.4.0",
    "@vueuse/shared": "^10.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.3",
    "electron-vite": "^1.0.27",
    "eslint": "^8.47.0",
    "eslint-plugin-vue": "^9.17.0",
    "happy-dom": "^14.12.3",
    "less": "^4.2.0",
    "prettier": "^3.0.2",
    "typescript": "^5.1.6",
    "unplugin-auto-import": "^0.17.2",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^4.4.9",
    "vitest": "^1.0.0",
    "vue": "^3.3.4",
    "vue-tsc": "^2.1.10"
  }
}
