{
    "compilerOptions": {
        "composite": true,
        "ignoreDeprecations": "5.0",
        "baseUrl": ".",
        "paths": {
            "@renderer/*": [
                "src/renderer/src/*"
            ],
            "@shared/*": [
                "src/shared/*"
            ]
        },
        "types": [
            "element-plus/global"
        ]
    },
    "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
    "include": [
        "src/renderer/src/env.d.ts",
        "src/renderer/src/**/*",
        "src/renderer/src/**/*.vue",
        "src/renderer/src/**/**/*.vue",
        "src/renderer/src/**/*.ts",
        "src/preload/*.d.ts",
        "src/shared/**/*"
    ]
}
